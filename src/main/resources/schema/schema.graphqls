type Query {
    analisisCalificaciones: [PromedioCalificacionPorTipo!]!
    tasaConversionClicksReservas: [TasaConversionLibro!]!
    estadoSaludCatalogo: EstadoSaludCatalogo!
}

type PromedioCalificacionPorTipo {
    tipo: TipoLibro!
    puntajePromedio: Float!
}

type TasaConversionLibro {
    libroId: ID!
    titulo: String!
    autor: String!
    clicks: Int!
    reservas: Int!
    tasaConversion: Float!
}

enum TipoLibro {
    COMUN
    DEDICATORIA
    COLECCIONABLE
}

#Punto 5.
extend type Query {
    feedActividadReciente: [ActividadReciente!]!
}

# Los campos obligatorios
interface ActividadReciente {
    fecha: String!
    tipoEvento: String!
    usuario: String!
}

# 1. Alta de un Libro
type NuevoLibroEvento implements ActividadReciente {
    fecha: String!
    tipoEvento: String!
    usuario: String!
    libroId: ID!
    titulo: String!
}

# 2. Confirmación de Reserva
type NuevaReservaEvento implements ActividadReciente {
    fecha: String!
    tipoEvento: String!
    usuario: String!
    reservaId: ID!
}

# 3. Estado de Salud del Catálogo de Libros
type EstadoSaludCatalogo {
    total: Int!
    prestados: Int!
    disponiblesNuncaReservados: Int!
    disponiblesReservadosAFuturo: Int!
    disponiblesDevueltos: Int!
}