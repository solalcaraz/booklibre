type Query {
    analisisCalificaciones: [PromedioCalificacionPorTipo!]!
    tasaConversionClicksReservas: [TasaConversionLibro!]!
}

type PromedioCalificacionPorTipo {
    tipo: TipoLibro!
    puntajePromedio: Float!
}

type TasaConversionLibro {
    libroId: ID!
    titulo: String!
    autor: String!
    clicks: Int!
    reservas: Int!
    tasaConversion: Float!
}

enum TipoLibro {
    COMUN
    DEDICATORIA
    COLECCIONABLE
}
